{
  "name": "bank-statement-qif-converter",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "100% offline, client-side web app to convert CSV, XLS, XLSX, and unencrypted PDF financial statements into verified Quicken Interchange Format (QIF) files.",
  "author": {
    "name": "Vipul Soneji",
    "url": "https://github.com/vsoneji"
  },
  "homepage": "https://vsoneji.github.io/quicken-converter/",
  "repository": {
    "type": "git",
    "url": "https://github.com/vsoneji/quicken-converter.git"
  },
  "keywords": [
    "qif",
    "quicken",
    "bank-statement",
    "csv",
    "excel",
    "pdf",
    "offline",
    "privacy",
    "pwa",
    "personal-finance"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "idb": "^8.0.2",
    "lucide-react": "^0.475.0",
    "papaparse": "^5.5.2",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.7"
  }
